# x86_64-only additions, merged after davit.config (scripts/kernel-inner.sh).

# --- i8042 keyboard controller: Firecracker's SendCtrlAltDel injects the key chord here, so a VM
# can be stopped cleanly (systemd ctrl-alt-del.target) without the guest agent. Same set as FC's
# own ci.config "Needed for CTRL+ALT+DEL support".
# Firecracker implements SendCtrlAltDel on x86_64 only.
CONFIG_INPUT=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_SERIO_LIBPS2=y
