# AppArmor profile for {{.Command}} at the path below. Generated by
# `{{.Command}} init --apparmor`; re-run it after moving the binary and
# reinstall the result (the profile name follows the path).
#
# It allows everything (flags=(unconfined)) and exists only so that the binary
# below may create unprivileged user namespaces on hosts with
# kernel.apparmor_restrict_unprivileged_userns=1 (Ubuntu 23.10 and later), the
# same pattern Ubuntu uses for its own userns profiles. Programs {{.Command}} starts
# (unshare, nsenter, ip, nft, firecracker) keep this profile unless they have
# an attached profile of their own.

abi <abi/4.0>,
include <tunables/global>

profile {{.Name}} {{.Attach}} flags=(unconfined) {
  userns,

  # Site-specific additions and overrides. See local/README for details.
  include if exists <local/{{.Name}}>
}
