# {{.Name}} host daemon, systemd --user unit. Generated by `{{.Name}} init --service`;
# re-run init with --force to regenerate after editing by hand.
[Unit]
Description={{.Name}} host daemon (self-hosted agent VMs)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart="{{.Binary}}" daemon --config "{{.Config}}"
# Optional KEY=VALUE file, e.g. {{.AuthKeyEnv}}=... for tailnet enrollment.
# Keep secrets there (mode 0600), never inline in this unit.
EnvironmentFile=-{{.EnvFile}}
Restart=on-failure
RestartSec=2
TimeoutStopSec=30
# VM processes must outlive daemon restarts (the daemon reattaches to them),
# so stopping the daemon must not kill its whole cgroup.
KillMode=process
UMask=0077

[Install]
WantedBy=default.target
