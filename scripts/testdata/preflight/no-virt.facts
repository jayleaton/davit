probe_version=1
user=ubuntu
groups=ubuntu
hostname=cloud-vm
distro=Debian GNU/Linux 12 (bookworm)
arch=x86_64
kernel=5.4.0-200-generic
cpus=2
cpu_virt=none
mem_total_kib=2097152
kvm=missing
tun=missing
kvm_group=
kvm_module=
cgroup_fs=tmpfs
cgroup_controllers=
userns=fail
userns_error=unshare: unshare failed: Operation not permitted
sysctl_apparmor_restrict_userns=
sysctl_unprivileged_userns_clone=0
sysctl_max_user_namespaces=15000
subuid=65536
subgid=65536
newuidmap=/usr/bin/newuidmap
vhost_vsock=absent
fs_path=/home/ubuntu/.svm/fs
fs_checked=/home/ubuntu
fs_type=zfs
fs_free_kib=garbage
fs_reflink=unknown
missing_tools=
svm_dir=/home/ubuntu/.svm
