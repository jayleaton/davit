{
  "name": "@davit/sdk",
  "version": "0.1.0",
  "description": "TypeScript client for the davit API: self-hosted fast VMs for AI agents.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "gen": "node scripts/gen-schema.ts",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "test": "node test/run.ts",
    "test:bun": "bun test ./test/",
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "yaml": "2.9.1"
  }
}
